<?xml version="1.0"?>
<ruleset name="FAQ JSON-LD">
	<description>Coding standard for the FAQ JSON-LD WordPress plugin: WordPress Coding Standards.</description>

	<file>faq-jsonld.php</file>
	<file>uninstall.php</file>
	<file>includes</file>

	<exclude-pattern>*/vendor/*</exclude-pattern>
	<exclude-pattern>*/node_modules/*</exclude-pattern>

	<arg name="extensions" value="php"/>
	<arg value="sp"/>

	<rule ref="WordPress"/>
</ruleset>
