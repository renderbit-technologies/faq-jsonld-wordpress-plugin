<?xml version="1.0"?>
<ruleset name="Renderbit FAQ Structured Data">
	<description>Coding standard for the Renderbit FAQ Structured Data WordPress plugin: WordPress Coding Standards.</description>

	<file>renderbit-faq-structured-data.php</file>
	<file>uninstall.php</file>
	<file>includes</file>
	<file>bin</file>

	<exclude-pattern>*/vendor/*</exclude-pattern>
	<exclude-pattern>*/node_modules/*</exclude-pattern>

	<arg name="extensions" value="php"/>
	<arg value="sp"/>

	<rule ref="WordPress"/>
	<rule ref="WordPress.WP.I18n">
		<properties>
			<property name="text_domain" type="array">
				<element value="renderbit-faq-structured-data"/>
			</property>
		</properties>
	</rule>
</ruleset>
