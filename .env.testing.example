# Local PHPUnit database settings, loaded by tests/php/bootstrap.php.
# Copy to .env.testing (gitignored) and fill in your values. Variables already set in the
# environment take precedence. The suite wipes this database on every run.
WP_TESTS_DB_HOST=127.0.0.1
WP_TESTS_DB_NAME=wordpress_test
WP_TESTS_DB_USER=root
WP_TESTS_DB_PASSWORD=
