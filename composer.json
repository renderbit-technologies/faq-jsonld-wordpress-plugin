{
  "name": "renderbit/renderbit-faq-structured-data",
  "description": "WordPress plugin to manage FAQ items as CPT and inject FAQ JSON-LD with advanced caching and queueing.",
  "type": "wordpress-plugin",
  "license": "GPL-2.0-or-later",
  "version": "3.1.1",
  "keywords": ["wordpress", "plugin", "faq", "json-ld", "schema", "cpt"],
  "authors": [
    {
      "name": "Soham Banerjee",
      "email": "soham@renderbit.com"
    },
    {
      "name": "Renderbit Technologies",
      "email": "renderbit.technologies@gmail.com"
    }
  ],
  "require": {
    "php": ">=7.2",
    "composer/installers": "^1.9 || ^2.0"
  },
  "autoload": {
    "psr-4": {
      "RFSD\\": "includes/"
    }
  },
  "extra": {
    "installer-name": "renderbit-faq-structured-data"
  },
  "config": {
    "allow-plugins": {
      "composer/installers": true,
      "dealerdirect/phpcodesniffer-composer-installer": true
    },
    "platform": {
      "php": "7.4.33"
    }
  },
  "scripts": {
    "build-zip": "rm -f renderbit-faq-structured-data.zip && git archive --format=zip --prefix=renderbit-faq-structured-data/ -o renderbit-faq-structured-data.zip HEAD",
    "check-zip": "bash bin/check-zip.sh renderbit-faq-structured-data.zip",
    "lint": "phpcs",
    "test": "phpunit",
    "test:multisite": "phpunit -c phpunit-multisite.xml.dist",
    "bump-major": "php bin/bump-version.php major && composer update --lock",
    "bump-minor": "php bin/bump-version.php minor && composer update --lock",
    "bump-patch": "php bin/bump-version.php patch && composer update --lock",
    "git-tag": "git tag v$(php -r 'echo json_decode(file_get_contents(\"composer.json\"))->version;')"
  },
  "require-dev": {
    "wp-coding-standards/wpcs": "^3.4.1",
    "dealerdirect/phpcodesniffer-composer-installer": "^1.0",
    "phpunit/phpunit": "^9.6",
    "yoast/phpunit-polyfills": "^4.0",
    "wp-phpunit/wp-phpunit": "^7.1",
    "roots/wordpress-no-content": "^7.1",
    "vlucas/phpdotenv": "^5.6"
  }
}
